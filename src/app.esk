// The root: the theme, the screens of the current route, and the tabs under them. Routes:
// "/" (Home), "/packages", "/packages/:name" and "/settings"; on the web they are the URL.
import <string>;
import <ui>;
import <ui/kit>;
import "model.esk";
import "components/tabs.esk";
import "screens/home.esk";
import "screens/packages.esk";
import "screens/detail.esk";
import "screens/settings.esk";

// The theme the user chose, or the system's appearance.
void apply_theme() {
    int mode = model.theme.get();
    if (mode == ThemeLight) { kit = kit_light(); }
    else if (mode == ThemeDark) { kit = kit_dark(); }
    else { kit_follow_system(); }
}

void Screen(*Router router, string route) {
    // route_param keeps the name as long as the route is on the stack, so the screen's blocks
    // can use it when they render again on their own.
    string name = route_param("/packages/:name", route, 0);
    if (name != null) { DetailScreen(router, name); }
    else if (strcmp(route, "/packages") == 0) { PackagesScreen(router); }
    else if (strcmp(route, "/settings") == 0) { SettingsScreen(router); }
    else { HomeScreen(router); }
}

void App() {
    apply_theme();
    Column(Style{grow: 1, background: kit.page, gap: 0}) {
        StatusBar(kit.dark ? BarLight : BarDark, false);
        Column(Style{grow: 1, gap: 0}) {
            Navigator(model.router, void(string route) { Screen(model.router, route); });
        }
        Separator();
        BottomTabs(model.router);
        ToastHost();
    }
}
